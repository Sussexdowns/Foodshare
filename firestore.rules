rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read-only access to the items catalog
    match /items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // Submissions: require Google auth (non-anonymous), only approved items are readable
    match /sources/{sourceId} {
      // Only approved sources are publicly readable
      allow read: if resource.data.approved == true;

      // Authenticated Google users can create new source submissions
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider == 'google.com'
                    && request.resource.data.keys().hasAll([
                        'name', 'type', 'category', 'lat', 'lng', 'timestamp'
                      ])
                    && request.resource.data.name is string
                    && request.resource.data.type is string
                    && request.resource.data.category is string
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.lat >= -90
                    && request.resource.data.lat <= 90
                    && request.resource.data.lng >= -180
                    && request.resource.data.lng <= 180
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.type.size() >= 2
                    && request.resource.data.type.size() <= 100
                    && request.resource.data.category.size() >= 2
                    && request.resource.data.category.size() <= 100
                    && !request.resource.data.name.matches('.*[<>].*')
                    && !request.resource.data.type.matches('.*[<>].*')
                    && (!(request.resource.data.description is string) || !request.resource.data.description.matches('.*[<>].*'))
                    && (!(request.resource.data.shortDescription is string) || !request.resource.data.shortDescription.matches('.*[<>].*'));

      allow update, delete: if false;
    }

    // Reports collection - admins can read/update/delete, users can create
    match /reports/{reportId} {
      // Admins can read, update, delete
      allow read, update, delete: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      // Authenticated Google users can create reports
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider == 'google.com'
                    && request.resource.data.keys().hasAll(['sourceId', 'reason', 'userId', 'name'])
                    && request.resource.data.sourceId is string
                    && request.resource.data.reason is string
                    && request.resource.data.userId is string
                    && request.resource.data.name is string
                    && (request.resource.data.details is string || request.resource.data.details == null);
    }

    // Feedback collection for likes/dislikes (if used directly in Firestore)
    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider == 'google.com'
                    && request.resource.data.keys().hasAll(['sourceId', 'type', 'userId'])
                    && request.resource.data.sourceId is string
                    && request.resource.data.type in ['like', 'dislike', 'report']
                    && request.resource.data.userId is string;
      allow update, delete: if false;
    }

    // User profiles - users can read/write own profile, admins can manage all
    match /users/{userId} {
      // Users can read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can create their own profile (first sign-in) with basic fields
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
                    && request.resource.data.email is string
                    && request.resource.data.displayName is string
                    && request.resource.data.role is string
                    && request.resource.data.role in ['user', 'admin']
                    && request.resource.data.createdAt is timestamp;
      
      // Users can update their own profile (but not role)
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role // role cannot be changed by user
                    && request.resource.data.keys().hasOnly(['email', 'displayName', 'photoURL', 'role']); // only allowed fields
      
      // Admins can update any user's role
      allow update: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider == 'google.com'
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      
      // Users can delete their own profile (optional)
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
